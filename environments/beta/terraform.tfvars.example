# Non-secret identifiers. Find these in the Cloudflare dashboard.
cloudflare_account_id = "REPLACE_WITH_CLOUDFLARE_ACCOUNT_ID"
cloudflare_zone_id    = "REPLACE_WITH_VOLTIMUSMAXIMUS_COM_ZONE_ID"

